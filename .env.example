# ---- Database (local SQLite by default) -------------------------------
# Leave DATABASE_URL empty to use the local SQLite file at ./data/saham.db
# DATABASE_URL=file:./data/saham.db
#
# To deploy on Vercel, create a free Turso database and set both values:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=<your-turso-token>

# ---- Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# REQUIRED in production. In development a generated fallback is used.
AUTH_SECRET=

# ---- App --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SahamSignal
